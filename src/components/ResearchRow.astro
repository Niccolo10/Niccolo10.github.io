---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'research'> | CollectionEntry<'bugCode'>; index?: number; }
const { entry, index = 0 } = Astro.props;
---
<a class="research-row" href={`/${entry.collection === 'bugCode' ? 'bug-code' : 'research'}/${entry.id}/`}>
  <span class="row-number mono">{String(index + 1).padStart(2, '0')}</span>
  <div><div class="article-meta"><span>{entry.collection === 'bugCode' ? 'The Bug Code' : entry.data.category}</span><span>{entry.collection === 'bugCode' ? `Article ${entry.data.rule}` : entry.data.cve || entry.data.date.getFullYear()}</span></div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div>
  <span class="row-arrow" aria-hidden="true">↗</span>
</a>
