---
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Niccolò Parlanti — Offensive security & research', description = 'Penetration tester, bug bounty hunter, and security campaign and triage practitioner at UNGUESS. Selected research by Niccolò Parlanti.' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f5f3ec" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Niccolò Parlanti — Research" href="/feed.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="identity" href="/" aria-label="Niccolò Parlanti home"><span class="monogram">np<span>↗</span></span><span>Niccolò Parlanti<span class="identity-sub">OFFENSIVE SECURITY</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/bug-code/" aria-current={path.startsWith('/bug-code') ? 'page' : undefined}>Bug Code</a>
        <a href="/research/" aria-current={path.startsWith('/research') ? 'page' : undefined}>Research</a>
        <a href="/archive/" aria-current={path.startsWith('/archive') ? 'page' : undefined}>Archive</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a class="nav-contact" href="/about/#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><p>© {new Date().getFullYear()} Niccolò Parlanti</p><p>Offensive security / Research notes</p><div><a href="https://github.com/Niccolo10">GitHub ↗</a><a href="https://www.linkedin.com/in/niccol%C3%B2-parlanti/">LinkedIn ↗</a><a href="/feed.xml">RSS</a></div></footer>
  </body>
</html>
